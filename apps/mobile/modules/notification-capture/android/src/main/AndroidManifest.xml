<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Debug test sender only (simulated captures are posted as a real notification so the flow can be seen). -->
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <uses-permission android:name="android.permission.WAKE_LOCK" />
  <application>
    <!--
      Reads notifications posted by the allow-listed bank / e-wallet apps only (CaptureConfig). The user grants
      access in Settings > Notification access; the app's own switch turns capture off without revoking it.
    -->
    <service
      android:name="com.joyodigitama.joyoarto.capture.CaptureListenerService"
      android:label="JoyoArto capture"
      android:exported="true"
      android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
      <intent-filter>
        <action android:name="android.service.notification.NotificationListenerService" />
      </intent-filter>
    </service>
    <!-- Runs the JS capture task (parse, queue, send) when the app is not open. -->
    <service
      android:name="com.joyodigitama.joyoarto.capture.CaptureHeadlessService"
      android:exported="false" />
  </application>
</manifest>
