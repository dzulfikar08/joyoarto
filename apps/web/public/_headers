# Response headers for static assets (Workers static assets, same syntax as Pages). The Worker's own responses
# (/api, /rpc, /mcp, /.well-known, /robots.txt) are not covered here: apps/server/src/seo.ts adds X-Robots-Tag to those.
# Only https://arto.joyorogo.com is indexed; index.html also turns <meta name="robots"> into noindex on other hosts.

https://app.arto.joyorogo.com/*
  X-Robots-Tag: noindex

https://baroka.by.dzulfikar.com/*
  X-Robots-Tag: noindex

https://:worker.:account.workers.dev/*
  X-Robots-Tag: noindex

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/og/*
  Cache-Control: public, max-age=86400
